# Ignore versioning
node_modules/
dist/
build/
.env.local
.env.*.local

# Dependencies
# pnpm-lock.yaml is tracked on purpose: deploy.bat runs
# `pnpm install --frozen-lockfile`, which needs the lockfile to exist and to
# match package.json. Without it a fresh clone cannot install at all.
package-lock.json
yarn.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log
npm-debug.log*

# Build outputs
.next/
out/
*.tsbuildinfo

# Database
*.db
*.sqlite

# Environment
.env
.env.*.local

# IDE
vscode/
.prettierignore
.eslintignore

# OS
Thumbs.db
.DS_Store

# Temporary
tmp/
temp/
*.tmp
scratch/
