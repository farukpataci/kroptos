# Uygulama bağlantısı: RLS için NOBYPASSRLS rol (prisma/scripts/p12-rls-00-role.sql)
DATABASE_URL=postgresql://kroptos_app:password@localhost:5432/kroptos_db
# Şema (db push) ve seed: superuser / tablo sahibi — pnpm db:push, pnpm db:seed bunu kullanır
DATABASE_MIGRATION_URL=postgresql://admin:password@localhost:5432/kroptos_db
JWT_SECRET=dev-jwt-secret-min-32-characters
ENCRYPTION_KEY=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4
REDIS_URL=redis://localhost:6379
NODE_ENV=development
# Ortam: production | staging | development | test (src/common/utils/outbound-guard.ts)
# staging'de varsayılan: dış HTTP KAPALI, bildirimler console. production ve development'ta davranış değişmez.
APP_ENV=development
# allow | block — boşsa APP_ENV'e göre
OUTBOUND_HTTP=
# staging'de izin verilen dış hostlar (sağlayıcı test ortamları), virgüllü; *.ornek.com alt alanları kapsar
OUTBOUND_ALLOWLIST=
# send | console — boşsa APP_ENV'e göre
NOTIFICATIONS_DELIVERY=
API_PORT=3001
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug

# Seed: superadmin@kroptos.com yalniz YOKSA olusturulur (var olanin sifresi sifirlanmaz).
# production/staging: bu degisken yoksa kullanici olusturulmaz; development: yoksa rastgele uretilip konsola basilir.
SEED_SUPERADMIN_PASSWORD=

# OAuth callback tabani (IdeaSoft redirect_uri): yoksa istekten (protocol://host) turetilir; ters proxy arkasinda ver.
API_PUBLIC_URL=
