model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku        String
  name       String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
}

model OrderTimeline {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType String
  oldValue  String?
  newValue  String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ==================== Audit & Integration ====================

model AuditLog {
  id                String   @id @default(cuid())
  tenantId          String?  @map("agencyId") // Mapping to maintain relation with Agency table without changing DB column name if it exists, or just use agencyId as tenantId
  agency            Agency?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId            String?
  User              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail         String?
  userName          String?
  action            String // "auth.login", "product.update", etc.
  module            String? // "commerce", "auth", "warehouse", etc.
  entityType        String // "product", "order", "user", etc.
  entityId          String
  entityDisplayName String?
  description       String?  @db.Text
  oldValue          Json?
  newValue          Json?
  metadata          Json?
  ipAddress         String?
  userAgent         String?
  requestId         String?
  severity          String   @default("info") // info, warning, error, critical
  createdAt         DateTime @default(now())

  // Additional backwards-compatible relations for schema integrity
  storeId     String?
  store       Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  Client      Client?    @relation(fields: [clientId], references: [id])
  clientId    String?
  Product     Product?   @relation(fields: [productId], references: [id])
  productId   String?
  Inventory   Inventory? @relation(fields: [inventoryId], references: [id])
  inventoryId String?
  Order       Order?     @relation(fields: [orderId], references: [id])
  orderId     String?

  @@index([tenantId])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}

model IntegrationLog {
  id               String    @id @default(cuid())
  tenantId         String
  integrationType  String // marketplace, accounting, shipping, warehouse, payment
  provider         String // trendyol, logo, yurtici, etc.
  operation        String // order.import, stock.sync, etc.
  entityType       String?
  entityId         String?
  sourceSystem     String?
  targetSystem     String?
  sourceReference  String?
  targetReference  String?
  status           String    @default("pending") // pending, processing, success, failed, retrying, resolved, ignored
  severity         String    @default("error") // info, warning, error, critical
  requestPayload   Json?
  responsePayload  Json?
  errorCode        String?
  errorMessage     String?   @db.Text
  errorStack       String?   @db.Text
  errorStep        String?
  suggestedAction  String?   @db.Text
  retryCount       Int       @default(0)
  maxRetryCount    Int       @default(3)
  nextRetryAt      DateTime?
  resolvedAt       DateTime?
  resolvedByUserId String?
  resolutionNote   String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([tenantId])
  @@index([provider])
  @@index([status])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Integration {
  id                   String    @id @default(cuid())
  agencyId             String
  agency               Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId             String?
  client               Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  storeId              String?
  store                Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  provider             String
  providerType         String
  name                 String
  credentialsEncrypted String
  status               String    @default("active")
  publicId             String?   @unique
  lastSyncAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  queue           IntegrationQueue[]
  apiLogs         ApiLog[]
  productMappings ProductMapping[]
  setting         IntegrationSetting?

  @@index([agencyId])
  @@index([clientId])
  @@index([storeId])
  @@index([providerType])
  @@index([deletedAt])
}

/// Per-integration behaviour settings, shaped by the provider's settings manifest.
/// Credentials stay on Integration.credentialsEncrypted; this model only holds
/// what the integration *does* with them.
model IntegrationSetting {
  id            String      @id @default(cuid())
  integrationId String      @unique
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  /// Denormalised from Integration so every query can filter on tenant without a join.
  agencyId String
  clientId String?
  storeId  String?

  provider      String // resolves which manifest applies
  schemaVersion Int    @default(1)

  /// Flat "<section>.<field>" map holding only what the user explicitly set.
  /// Manifest defaults are merged in at read time and never written here.
  values           Json    @default("{}")
  /// Values of fields marked `secret: true` (AES-256, common/utils/encryption.util).
  secretsEncrypted String?

  isConfigured   Boolean   @default(false)
  completedSteps String[]  @default([])
  lastAppliedAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  revisions IntegrationSettingRevision[]

  @@index([agencyId])
  @@index([clientId])
  @@index([storeId])
  @@index([provider])
  @@index([deletedAt])
}

model IntegrationSettingRevision {
  id                   String             @id @default(cuid())
  integrationSettingId String
  integrationSetting   IntegrationSetting @relation(fields: [integrationSettingId], references: [id], onDelete: Cascade)
  version              Int
  values               Json
  /// { "stock.bufferQuantity": { "before": 0, "after": 5 } }
  diff                 Json?
  changedByUserId      String?
  changedByName        String?
  note                 String?
  createdAt            DateTime           @default(now())

  @@unique([integrationSettingId, version])
  @@index([integrationSettingId])
}

model ProductMapping {
  id            String      @id @default(cuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  marketplaceCategoryId   String // Örn: "387" (Tişört)
  marketplaceCategoryName String // Örn: "Erkek Tişört"
  attributesMapping       Json? // Örn: { "338": "M", "343": "Siyah" }

  status               String  @default("draft") // draft, synced, error
  errorMessage         String?
  marketplaceProductId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, integrationId])
  @@index([productId])
  @@index([integrationId])
}

model IntegrationQueue {
  id          String      @id @default(cuid())
  agencyId    String
  configId    String
  config      Integration @relation(fields: [configId], references: [id], onDelete: Cascade)
  eventType   String
  status      String      @default("pending")
  payload     String
  error       String?
  retryCount  Int         @default(0)
  maxRetries  Int         @default(3)
  processedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([configId])
  @@index([status])
  @@index([eventType])
}

model ApiLog {
  id            String       @id @default(cuid())
  agencyId      String
  storeId       String?
  integrationId String?
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  endpoint      String
  method        String
  requestBody   String?      @db.Text
  responseBody  String?      @db.Text
  statusCode    Int
  durationMs    Int
  errorMessage  String?
  createdAt     DateTime     @default(now())

  @@index([agencyId])
  @@index([integrationId])
}

model WebhookSubscription {
  id        String   @id @default(cuid())
  agencyId  String
  eventType String // "order.created", "order.updated"
  url       String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

