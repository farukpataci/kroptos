// Backend - Prisma ORM Configuration
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==================== Core Models ====================

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  passwordHash         String
  firstName            String?
  lastName             String?
  avatar               String?
  isActive             Boolean   @default(true)
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?
  twoFactorBackupCodes String[]  @default([])
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  phone                String?
  bio                  String?
  location             String?
  country              String?
  city                 String?
  state                String?
  postalCode           String?
  taxId                String?
  fullAddress          String?
  facebookUrl          String?
  xUrl                 String?
  linkedinUrl          String?
  instagramUrl         String?

  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  sessions      Session[]
  storeUsers    StoreUser[]

  @@index([email])
  @@index([deletedAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ==================== Tenant Hierarchy ====================

model Agency {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  logo        String?
  website     String?
  isActive    Boolean   @default(true)
  publicId    String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  clients            Client[]
  stores             Store[]
  users              UserRole[]
  products           Product[]
  orders             Order[]
  categories         Category[]
  inventories        Inventory[]
  auditLogs          AuditLog[]
  integrations       Integration[]
  wmsPrinterSettings WmsPrinterSettings[]
  wmsShippingLabels  WmsShippingLabel[]
  wmsPrintJobs       WmsPrintJob[]
  wmsStockMovements  WmsStockMovement[]
  wmsPackagingTasks  WmsPackagingTask[]
  warehouses         Warehouse[]
  roles              Role[]
  invitations        Invitation[]

  @@index([deletedAt])
}

model Client {
  id                  String    @id @default(cuid())
  agencyId            String
  agency              Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name                String
  legalName           String?
  taxNumber           String?
  taxOffice           String?
  email               String    @default("")
  phone               String?
  contactEmail        String
  contactPhone        String?
  address             String?
  city                String?
  country             String?
  isActive            Boolean   @default(true)
  status              String    @default("active")
  orderProcessingMode String    @default("LOGO_SYNC") // LOGO_SYNC, POOL_ONLY, MANUAL_APPROVAL
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  stores       Store[]
  users        UserRole[]
  orders       Order[]
  auditLogs    AuditLog[]
  products     Product[]
  categories   Category[]
  integrations Integration[]

  @@index([agencyId])
  @@index([deletedAt])
}

model Store {
  id                  String    @id @default(cuid())
  agencyId            String
  agency              Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId            String?
  client              Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name                String
  slug                String    @default("")
  domain              String?
  status              String    @default("active") // draft, active, suspended
  currency            String    @default("USD")
  locale              String    @default("en-US")
  timezone            String    @default("UTC")
  type                String    @default("retail") // retail, warehouse, pop
  orderProcessingMode String    @default("LOGO_SYNC") // LOGO_SYNC, POOL_ONLY, MANUAL_APPROVAL
  address             String?
  city                String?
  country             String?
  isActive            Boolean   @default(true)
  publicId            String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  users        UserRole[]
  storeUsers   StoreUser[]
  products     Product[]
  categories   Category[]
  inventories  Inventory[]
  orders       Order[]
  auditLogs    AuditLog[]
  integrations Integration[]

  @@index([agencyId])
  @@index([clientId])
  @@index([deletedAt])
}

// ==================== RBAC ====================

model Role {
  id          String       @id @default(cuid())
  // null = sistem rolu (seed), dolu = o ajansin ozel rolu
  agencyId    String?
  agency      Agency?      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  // Makine adi (agency_owner, store_manager...). Benzersizlik Prisma ile IFADE EDILEMIYOR:
  // agencyId NULL olan iki sistem rolu @@unique([agencyId, key]) altinda ayni key ile girebilir
  // (PostgreSQL NULL != NULL). Iki partial unique index SQL ile tutuluyor, bkz.
  // prisma/scripts/p3-role-schema.sql: role_agency_key_uq (agencyId NOT NULL) ve
  // role_system_key_uq (agencyId NULL); ikisi de deletedAt IS NULL uzerinde.
  key         String
  // Gorunen ad; artik unique degil
  name        String
  description String?
  isSystem    Boolean      @default(false)
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  permissions Permission[]

  userRoles UserRole[]
  StoreUser StoreUser[]

  @@index([agencyId])
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique // kaynak.aksiyon, e.g., "products.create", "orders.read"
  description String?
  category    String  @default("") // UI gruplamasi; izin GLOBAL kalir, tenant'a baglanmaz
  roles       Role[]
}

model UserRole {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyId  String
  agency    Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  storeId   String?
  store     Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  roleId    String
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Benzersizlik SQL partial index ile (prisma/scripts/p3-role-schema.sql, userrole_scope_uq):
  // (userId, agencyId, COALESCE(clientId,''), COALESCE(storeId,''), roleId) WHERE deletedAt IS NULL.
  // Eski @@unique([userId, agencyId, roleId]) ayni rolu iki magaza icin vermeyi engelliyordu.
  @@index([userId])
  @@index([agencyId])
  @@index([roleId])
  @@index([deletedAt])
}

model Invitation {
  id         String    @id @default(cuid())
  agencyId   String
  agency     Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId   String?
  storeId    String?
  email      String
  roleId     String
  tokenHash  String    @unique
  invitedBy  String
  status     String    @default("pending") // pending | accepted | revoked | expired
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([agencyId])
  @@index([email])
  @@index([status])
}

// ==================== Commerce ====================

model Category {
  id           String     @id @default(cuid())
  agencyId     String
  agency       Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  storeId      String?
  store        Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  parentId     String?
  parent       Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryParent")
  name         String
  slug         String
  description  String?
  icon         String?
  status       String     @default("active")
  isActive     Boolean    @default(true)
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  products Product[]

  @@index([agencyId])
  @@index([clientId])
  @@index([storeId])
  @@index([slug])
  @@index([parentId])
  @@index([deletedAt])
}

model Product {
  id            String             @id @default(cuid())
  agencyId      String
  agency        Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sku           String
  name          String
  description   String?
  price         Decimal            @default(0) @db.Decimal(10, 2)
  basePrice     Decimal            @db.Decimal(10, 2)
  costPrice     Decimal?           @db.Decimal(10, 2)
  barcode       String?
  currency      String             @default("USD")
  stockQuantity Int                @default(0)
  status        String             @default("active")
  weight        Decimal?           @db.Decimal(8, 3)
  width         Decimal?           @db.Decimal(8, 2)
  height        Decimal?           @db.Decimal(8, 2)
  depth         Decimal?           @db.Decimal(8, 2)
  image         String?
  erpCode       String?
  erpId         String?
  taxRate       Int                @default(20)
  publicId      String?            @unique
  locationId    String?
  location      WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationCode  String?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  // Variant, Bundle, and Cross-Sell Extensions
  type              ProductType        @default(SIMPLE)
  variantAttributes Json?
  parentId          String?
  parent            Product?           @relation("ProductVariants", fields: [parentId], references: [id], onDelete: Cascade)
  variants          Product[]          @relation("ProductVariants")
  bundleItems       BundleItem[]       @relation("BundleParent")
  partOfBundles     BundleItem[]       @relation("BundleChild")
  crossSellSources  CrossSellProduct[] @relation("CrossSellSource")
  crossSellTargets  CrossSellProduct[] @relation("CrossSellTarget")

  inventories       Inventory[]
  orderItems        OrderItem[]
  auditLogs         AuditLog[]
  wmsStockMovements WmsStockMovement[]
  stockMovements    StockMovement[]
  productMappings   ProductMapping[]

  @@unique([storeId, sku])
  @@index([agencyId])
  @@index([clientId])
  @@index([storeId])
  @@index([categoryId])
  @@index([deletedAt])
}

model Inventory {
  id           String   @id @default(cuid())
  agencyId     String
  agency       Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  availableQty Int      @default(0)
  reservedQty  Int      @default(0)
  defectiveQty Int      @default(0)
  reorderLevel Int      @default(10)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  adjustments InventoryAdjustment[]
  auditLogs   AuditLog[]

  @@unique([storeId, productId])
  @@index([agencyId])
  @@index([storeId])
  @@index([productId])
}

model InventoryAdjustment {
  id          String    @id @default(cuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type        String // recount, damage, adjustment
  quantity    Int
  reason      String?
  performedBy String
  createdAt   DateTime  @default(now())

  @@index([inventoryId])
}

model Order {
  id                     String  @id @default(cuid())
  agencyId               String
  agency                 Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  clientId               String?
  client                 Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  storeId                String
  store                  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  channelId              String?
  // Unique per store, not globally: two marketplaces (or two tenants selling on
  // the same one) hand out the same order number, and a global constraint made
  // the second import look like an order that already existed — the row was
  // silently skipped and that tenant never received the order.
  orderNumber            String
  /// The number the marketplace shows the seller, when `orderNumber` had to be
  /// made composite. n11 splits one order into packages that ship and are
  /// cancelled separately, so each package is its own row — but the buyer and
  /// the seller both quote the original order number, and searching for it has
  /// to find every package under it.
  marketplaceOrderNumber String?
  customerId             String?
  customerName           String
  customerEmail          String?
  customerPhone          String?
  /// Legacy free text. Kept because 148 of 162 rows carry it and nothing else,
  /// but it is not a carrier address: a courier needs the district as its own
  /// field, and no parser gets that out of one line reliably enough to put a
  /// parcel on the right van.
  shippingAddress        String?

  /// The carrier address, field by field, as CarrierAddressDto needs it. The
  /// `shipping` prefix follows shippingAddress above; the buyer keeps the
  /// `customer` prefix.
  ///
  /// All nullable and no default, `shippingCountryCode` included: a default of
  /// 'TR' would read as "Turkey" on every row that was never filled in, and an
  /// international parcel would be labelled domestic without anyone choosing
  /// that. Missing means missing, and the label request says which field.
  ///
  /// The marketplace mappers already receive these apart — CicekSepetiMapper
  /// has order.district and order.city and joins them into one string — so
  /// filling these is a mapper change, not new data collection.
  shippingFullName    String?
  shippingPhone       String?
  shippingLine1       String?
  shippingLine2       String?
  shippingDistrict    String?
  shippingCity        String?
  shippingPostalCode  String?
  shippingCountryCode String?
