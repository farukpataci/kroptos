// ==================== Carrier / Shipping ====================
// Tenant columns are denormalised strings rather than relations, the same way
// IntegrationSetting carries them: every carrier query filters on tenant, and a
// join per filter buys nothing when the parent row already guarantees the id.

/// One configured carrier account. Credentials live here encrypted; what the
/// integration *does* with them lives in `settings`.
model CarrierIntegration {
  id       String  @id @default(cuid())
  publicId String  @unique
  agencyId String
  clientId String?
  storeId  String?

  /// CarrierProvider value from integrations/carriers/core/CarrierTypes.ts
  provider    String
  displayName String
  /// AES-256 JSON blob (common/utils/encryption.util) — never plaintext.
  credentials String

  isActive   Boolean @default(true)
  isTestMode Boolean @default(true)

  /// Default pickup address, shaped like CarrierAddress.
  senderAddress Json?
  /// labelFormat, cutoffTime, defaultServiceLevel, desiDivisor...
  settings      Json?

  lastTestedAt DateTime?
  lastTestOk   Boolean?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  shipments Shipment[]

  /// Postgres treats NULLs as distinct, so this constrains store-scoped rows
  /// only; agency-wide duplicates are caught in the service.
  @@unique([agencyId, storeId, provider])
  @@index([agencyId])
  @@index([storeId])
  @@index([provider])
  @@index([deletedAt])
}

model Shipment {
  id       String  @id @default(cuid())
  publicId String  @unique
  agencyId String
  clientId String?
  storeId  String

  orderId              String?
  carrierIntegrationId String?
  provider             String
  /// Aggregators resell other carriers: Geliver hands the parcel to ARAS, and
  /// the operator chasing it needs the name on the van, not the reseller's.
  subCarrier           String?

  trackingNumber    String?
  barcode           String?
  /// ShipmentStatus — normalised. The carrier's own code goes to
  /// carrierStatusCode; writing it here breaks every status filter downstream.
  status            String  @default("created")
  carrierStatusCode String?
  serviceLevel      String?
  paymentType       String  @default("sender_pays")

  codAmount          Decimal? @db.Decimal(12, 2)
  /// Without it a non-TRY amount cannot be reconciled after the fact.
  codCurrency        String?
  totalDesi          Decimal? @db.Decimal(10, 2)
  totalWeightKg      Decimal? @db.Decimal(10, 3)
  /// What the carrier actually bills: max(weight, desi) per parcel, summed.
  /// Invoice reconciliation is impossible without the figure that was charged.
  chargeableWeightKg Decimal? @db.Decimal(10, 3)
  /// Carrier's own charge, for invoice reconciliation.
  priceAmount        Decimal? @db.Decimal(12, 2)

  labelUrl      String?
  labelFormat   String?
  /// Idempotency key, derived from the order.
  referenceCode String?
  /// Test shipments must not mix into live reports. Defaults to false, unlike
  /// the connection's own flag: a shipment whose flag was never set is a real
  /// one, and defaulting it to `true` would hide live parcels from the reports
  /// that count money. The service always writes it from the connection.
  isTestMode    Boolean @default(false)

  senderAddress    Json?
  /// KVKK: PII. Masked before it reaches any log.
  recipientAddress Json?
  /// Free-text passed on to the carrier.
  notes            String?

  handedOverAt DateTime?
  deliveredAt  DateTime?

  /// KroptOS-side cancellation. Set even when the carrier refuses: the carrier
  /// owns its barcode, not our order state, so its refusal is recorded rather
  /// than allowed to block the operator.
  cancelledAt        DateTime?
  /// Set only when the carrier confirmed. Null with cancelledAt filled means
  /// the barcode may still be live at the carrier — someone must chase it.
  carrierCancelledAt DateTime?
  /// Why the carrier refused, kept for that chase.
  carrierCancelError String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  packages           ShipmentPackage[]
  events             ShipmentTrackingEvent[]
  wmsLabels          WmsShippingLabel[]
  carrierIntegration CarrierIntegration?     @relation(fields: [carrierIntegrationId], references: [id], onDelete: SetNull)

  @@unique([provider, trackingNumber])
  /// One order is shipped once. Scoped by store because the reference code is
  /// derived per store, and enforced by the database rather than a read-then-
  /// write check: two concurrent requests otherwise both see "no shipment yet"
  /// and buy two barcodes.
  @@unique([agencyId, storeId, referenceCode])
  @@index([agencyId])
  @@index([storeId])
  @@index([orderId])
  /// The idempotency lookup on create.
  @@index([agencyId, storeId, orderId])
  @@index([status])
  @@index([deletedAt])
}

model ShipmentPackage {
  id         String  @id @default(cuid())
  shipmentId String
  agencyId   String
  barcode    String?

  weightKg           Decimal @db.Decimal(10, 3)
  lengthCm           Decimal @db.Decimal(8, 2)
  widthCm            Decimal @db.Decimal(8, 2)
  heightCm           Decimal @db.Decimal(8, 2)
  /// Computed by DesiCalculator, never by a connector.
  desi               Decimal @db.Decimal(10, 2)
  /// The billed figure for this parcel: max(weightKg, desi).
  chargeableWeightKg Decimal @db.Decimal(10, 3)

  contentDescription String?

  createdAt DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([agencyId])
}

model ShipmentTrackingEvent {
  id         String @id @default(cuid())
  shipmentId String
  agencyId   String

  status            String
  /// Required: the carrier's own code for THIS event, which is what makes the
  /// unique key below discriminate. Internal events carry a KROPTOS_* code.
  carrierStatusCode String
  description       String
  location          String?
  occurredAt        DateTime
  createdAt         DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  /// Webhooks and polling both deliver the same event; this makes reprocessing
  /// idempotent instead of duplicating the timeline.
  @@unique([shipmentId, carrierStatusCode, occurredAt])
  @@index([shipmentId])
  @@index([agencyId])
}

/// Which carrier a shipment should go to. Evaluated in ascending priority;
/// first match wins.
model CarrierRule {
  id       String  @id @default(cuid())
  agencyId String
  clientId String?
  storeId  String?

  name       String
  /// Lower runs first.
  priority   Int    @default(100)
  /// { minDesi, maxDesi, cities[], districts[], countryCodes[], marketplace, productTags[], codOnly }
  conditions Json
  /// { provider, serviceLevel, fallbackProvider }
  action     Json

  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([agencyId])
  @@index([storeId])
  @@index([priority])
  @@index([deletedAt])
}

/// Raw carrier callbacks. Stored before processing, including the ones whose
/// signature failed, so an unverified payload is visible but never acted on.
model CarrierWebhookEvent {
  id       String  @id @default(cuid())
  /// Resolved from the tracking number, never from the payload's own claim.
  agencyId String?
  provider String

  /// NOT NULL, same reason as ShipmentTrackingEvent.carrierStatusCode: Postgres
  /// treats NULLs as distinct, so a nullable column makes the unique below
  /// dedupe nothing and an at-least-once redelivery is applied twice. When the
  /// provider sends no event id, write the sha256 of the raw body.
  externalId  String
  payload     Json
  signatureOk Boolean   @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  /// At-least-once delivery: the same event id must not be applied twice.
  @@unique([provider, externalId])
  @@index([provider])
  @@index([processedAt])
}

// ==================== Accounting Models ====================

// Kimlik (provider + credential + ortam) — firma ekseninden AYRI
model AccountingIntegration {
  id                    String    @id @default(cuid())
  publicId              String    @unique
  agencyId              String
  clientId              String?
  storeId               String?
  provider              String // 'parasut' — registry doğrular, enum yapma
  name                  String
  environment           String    @default("MOCK") // MOCK | TEST | PRODUCTION
  status                String    @default("disconnected") // disconnected | connected | failed
  readiness             String    @default("SCAFFOLDED") // SCAFFOLDED | MOCK_READY | TEST_READY | PRODUCTION_READY
  credentials           String? // encrypt() ile şifreli JSON — ASLA düz metin
  scopeKey              String // §4.1 — NULL'lu unique tuzağının çözümü
  lastVerifiedAt        DateTime?
  lastSyncAt            DateTime?
  lastErrorMessage      String?
  // --- Agent rotası (docs/mikro.agent.md GÖREV 1) ---
  route                 String    @default("DIRECT") // DIRECT | AGENT — bağlantının özelliği, sağlayıcının değil (K5)
  agentId               String? // route=AGENT ise atanmış Agent
  exclusiveAgentId      String? // K9: bağlantı başına tek aktif Agent
  agentLeaseUntil       DateTime? // K9: kira; dolsa bile açık yazma işi varken devralma bloke
  transportSecurity     String? // K10: null=localhost | 'PLAINTEXT_LAN' (denetimde görünür istisna)
  maxSessions           Int       @default(1) // K14: eşzamanlılık tavanı bir lisans sınırıdır (Nebim vb.)
  credentialSetAt       DateTime? // K2: AGENT_LOCAL kimlik sunucuda YOK — yalnızca iz
  credentialSetBy       String?
  credentialFingerprint String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  companies AccountingCompany[]

  @@unique([provider, scopeKey])
  @@index([agencyId])
  @@index([storeId])
  @@index([exclusiveAgentId])
  @@index([deletedAt])
}

// Firma / dönem ekseni — Paraşüt'te company_id
model AccountingCompany {
  id                     String                @id @default(cuid())
  integrationId          String
  integration            AccountingIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  agencyId               String
  externalCompanyId      String // Paraşüt company_id
  name                   String?
  currency               String                @default("TRY")
  isDefault              Boolean               @default(false)
  defaultRetailContactId String? // KolayBi' B2C fallback perakende müşteri ID
  invoiceSeries          String?
  defaultAccountCodes    Json?
  postingDefaults        Json? // D6: sağlayıcının bildirdiği şemaya göre doğrulanır (K17)
  periodNo               String? // Mikro CalismaYili / Logo dönem — SessionKey ekseni (K4)
  branchCode             String? // Netsis şube — SessionKey ekseni (K4)
  isActive               Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deletedAt              DateTime?

  @@unique([integrationId, externalCompanyId])
  @@index([agencyId])
}

// Giden belge (fatura / tahsilat) — idempotency taşıyıcısı
model AccountingDocument {
  id             String   @id @default(cuid())
  agencyId       String
  clientId       String?
  storeId        String
  integrationId  String
  companyId      String
  type           String // 'sales_invoice' | 'payment'
  referenceCode  String // fatura: orderId · tahsilat: <documentId>:pay:<n>
  status         String   @default("pending") // pending|sent|failed|cancelled|cancel_failed
  externalId     String? // Paraşüt kaydının id'si — claim anında NULL
  externalNumber String?
  totalAmount    Decimal  @db.Decimal(18, 4)
  currency       String
  isTestMode     Boolean  @default(true)
  errorMessage   String?
  rawResponse    Json? // MASKELİ
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([agencyId, storeId, type, referenceCode]) // ← idempotency kilidi, DEĞİŞTİRME
  @@unique([integrationId, type, externalId])
  @@index([agencyId])
  @@index([status])
}

model AccountingContactMapping {
  id                String   @id @default(cuid())
  agencyId          String
  integrationId     String
  companyId         String
  kroptosKey        String // müşteri kimliği (e-posta/telefon/vergi no'dan türetilen normalize anahtar)
  externalContactId String
  displayName       String?
  taxNumber         String?
  status            String   @default("matched") // matched | unmatched
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([companyId, kroptosKey])
  @@unique([companyId, externalContactId])
  @@index([agencyId])
}

model AccountingProductMapping {
  id                String   @id @default(cuid())
  agencyId          String
  integrationId     String
  companyId         String
  productSku        String
  externalProductId String
  externalCode      String?
  externalName      String?
  status            String   @default("matched")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([companyId, productSku])
  @@index([agencyId])
}

// ============================================================================
// Muhasebe Agent çatısı — docs/mikro.agent.md GÖREV 1
// AccountingIntegration/AccountingCompany/AccountingDocument mevcut modellerin
// üstüne kurulur (§1.3). Hiçbir yeni modelde storeId yoktur.
// ============================================================================

model AgentInstance {
  id              String    @id @default(cuid())
  agencyId        String
  clientId        String?
  name            String // "MERKEZ-SRV01"
  status          String    @default("PENDING") // PENDING | ACTIVE | OFFLINE | REVOKED
  publicKey       String // K2: tarayıcıda credential bununla şifrelenir; sunucunun özel anahtarı YOK
  tunnelSecret    String? // hello HMAC doğrulaması için — encrypt() ile şifreli; cevapta ASLA dönmez
  certFingerprint String?
  agentVersion    String?
  osVersion       String?
  protocolVersion Int?
  clockSkewSec    Int? // K8: tarihe bağlı kimlik — saat farkı ölçülür
  lastHeartbeatAt DateTime?
  connectedNodeId String? // YALNIZCA gözlem — yönlendirme Redis pub/sub ile
  enrolledAt      DateTime?
  revokedAt       DateTime?
  revokedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([agencyId, name])
  @@index([agencyId])
  @@index([status])
}

model AgentEnrollmentCode {
  id            String    @id @default(cuid())
  agencyId      String
  clientId      String?
  codeHash      String    @unique // kodun kendisi SAKLANMAZ
  createdBy     String
  expiresAt     DateTime
  usedAt        DateTime?
  usedByAgentId String?
  createdAt     DateTime  @default(now())

  @@index([agencyId])
}

model AgentCredentialEnvelope {
  id            String   @id @default(cuid())
  agencyId      String
  agentId       String
  integrationId String
  blob          String // K2: Agent açık anahtarıyla şifreli; sunucu ÇÖZEMEZ; teslimde satır SİLİNİR
  fingerprint   String
  createdBy     String
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([agentId])
  @@index([agencyId])
}

model AgentJob {
  id             String    @id @default(cuid())
  agencyId       String
  agentId        String
  integrationId  String
  companyKey     String // SessionKey (K4)
  type           String // AgentJobType — kapalı küme (K6)
  payload        Json // MASKELİ — credential asla girmez (K1)
  idempotencyKey String? // yazma işlerinde zorunlu
  status         String    @default("queued") // queued | dispatched | running | ok | failed | expired
  attempt        Int       @default(0)
  notBefore      DateTime?
  expiresAt      DateTime
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  errorCode      String?
  resultRef      Json?
  createdAt      DateTime  @default(now())

  @@unique([agentId, idempotencyKey]) // Postgres'te NULL'lar çakışmaz
  @@index([agencyId])
  @@index([agentId, status])
  @@index([integrationId, companyKey, status])
}

model AccountingSyncCursor {
  id             String    @id @default(cuid())
  integrationId  String
  companyKey     String
  stream         String // STOCK | PRODUCT | PARTNER
  cursor         String? // sağlayıcı güvenilir imleç veremiyorsa NULL kalır (stockDelta NOT_SUPPORTED)
  lastFullSyncAt DateTime?
  lastDeltaAt    DateTime?
  staleSince     DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([integrationId, companyKey, stream])
}

model AccountingProblem {
  id            String    @id @default(cuid())
  agencyId      String
  integrationId String?
  agentId       String?
  companyKey    String?
  code          String // agent_offline | agent_failover_blocked | erp_auth_failed | erp_session_limit | erp_clock_skew | mapping_missing | stock_sync_stale | invoice_stuck | catalog_schema_drift
  severity      String    @default("warn") // info | warn | error
  occurrences   Int       @default(1) // aynı kod tekrarında sayaç artar, yeni satır AÇILMAZ
  detail        Json?
  firstSeenAt   DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  resolvedAt    DateTime?
  resolvedBy    String?

  @@unique([agencyId, integrationId, code, companyKey])
  @@index([agencyId])
}

// ==================== Order Automation ====================

model AutomationRule {
  id              String    @id @default(cuid())
  agencyId        String
  clientId        String?
  storeId         String

  name            String
  description     String?
  isActive        Boolean   @default(false)
  priority        Int       @default(100)
  scopeLevel      String    @default("STORE") // STORE, CLIENT, AGENCY

  /// ORDER_CREATED | ORDER_STATUS_CHANGED | PAYMENT_RECEIVED | SHIPMENT_CREATED |
  /// SHIPMENT_DELIVERED | SHIPMENT_EXCEPTION | RETURN_REQUESTED | ORDER_CANCELLED |
  /// STOCK_INSUFFICIENT | ORDER_IDLE | SCHEDULED
  triggerType     String
  triggerConfig   Json      @default("{}")

  /// AND / OR logic tree, schema versioned
  conditions      Json      @default("{\"version\":1,\"operator\":\"and\",\"conditions\":[]}")

  /// Sequential actions array: [{ type, config }]
  actions         Json      @default("[]")

  stopProcessing  Boolean   @default(false)
  runOncePerOrder Boolean   @default(false)
  version         Int       @default(1)

  createdById     String?
  updatedById     String?
  lastRunAt       DateTime?
  runCount        Int       @default(0)
  errorCount      Int       @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  versions        AutomationRuleVersion[]
  runs            AutomationRun[]

  @@index([agencyId])
  @@index([storeId])
  @@index([storeId, triggerType, isActive])
  @@index([priority])
  @@index([deletedAt])
}

model AutomationRuleVersion {
  id          String         @id @default(cuid())
  ruleId      String
  rule        AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  createdAt   DateTime       @default(now())
  createdById String?

  @@unique([ruleId, version])
  @@index([ruleId])
}

model AutomationRun {
  id             String                @id @default(cuid())
  agencyId       String
  clientId       String?
  storeId        String

  ruleId         String
  rule           AutomationRule        @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleVersion    Int                   @default(1)

  orderId        String
  order          Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)

  triggerEvent   String
  eventId        String
  matched        Boolean               @default(false)
  conditionTrace Json?

  /// MATCHED_SUCCESS | PARTIAL_FAILURE | FAILED | NOT_MATCHED | SKIPPED_LOOP | SKIPPED_ONCE | DRY_RUN
  status         String
  depth          Int                   @default(0)
  durationMs     Int?
  isDryRun       Boolean               @default(false)

  createdAt      DateTime              @default(now())

  actionRuns     AutomationActionRun[]

  @@unique([ruleId, eventId])
  @@index([agencyId])
  @@index([storeId])
  @@index([storeId, createdAt])
  @@index([orderId])
  @@index([ruleId, createdAt])
}

model AutomationActionRun {
  id           String        @id @default(cuid())
  runId        String
  run          AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  index        Int
  actionType   String
  /// SUCCESS | FAILED | SKIPPED | SCHEDULED
  status       String
  input        Json?
  output       Json?
  errorMessage String?
  attempts     Int           @default(1)
  scheduledFor DateTime?
  createdAt    DateTime      @default(now())

  @@index([runId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Bildirim şablonları (E-posta / SMS) — docs/eposta.md
// Kapsam: STORE > CLIENT > AGENCY (DB satırları) > SYSTEM (kodda, defaults.ts).
// Sistem varsayılanı DB'de tutulmaz: RLS altında agencyId'siz satır görünmez ve
// kodda olunca "silinemez/düzenlenemez" kuralı bedava gelir.
// ---------------------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationEvent {
  ORDER_CREATED
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  ORDER_CANCELLED
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  COD_REMINDER
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_RECEIVED
  REFUND_COMPLETED
  INVOICE_CREATED
  ORDER_STATUS_CHANGED
}

enum NotificationScope {
  AGENCY
  CLIENT
  STORE
}

enum NotificationLogStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

model NotificationTemplate {
  id               String              @id @default(cuid())
  agencyId         String
  clientId         String?
  storeId          String?
  /// clientId/storeId null olabildiği için tekillik bu türetilmiş anahtarla:
  /// `${clientId ?? '-'}:${storeId ?? '-'}` (Postgres NULL'ları eşit saymaz).
  scopeKey         String
  scopeLevel       NotificationScope
  channel          NotificationChannel
  event            NotificationEvent
  /// Yalnız ORDER_STATUS_CHANGED için: TenantSettings.settings.orderStatuses[].key. Diğerlerinde ''.
  orderStatusKey   String              @default("")
  locale           String              @default("tr")
  name             String
  subject          String?
  bodyHtml         String?             @db.Text
  bodyText         String              @db.Text
  isActive         Boolean             @default(true)
  senderName       String?
  replyTo          String?
  smsSenderId      String?
  sendDelayMinutes Int                 @default(0)
  version          Int                 @default(1)
  updatedById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  versions NotificationTemplateVersion[]
  logs     NotificationLog[]

  @@unique([agencyId, scopeKey, channel, event, orderStatusKey, locale])
  @@index([agencyId])
  @@index([storeId])
  @@index([deletedAt])
}

model NotificationTemplateVersion {
  id          String               @id @default(cuid())
  agencyId    String
  templateId  String
  template    NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  version     Int
  /// Kaydetmeden ÖNCEKİ içerik (subject, bodyHtml, bodyText, sender*, sendDelayMinutes)
  snapshot    Json
  createdById String?
  createdAt   DateTime             @default(now())

  @@unique([templateId, version])
  @@index([agencyId])
}

model NotificationLog {
  id                String                @id @default(cuid())
  agencyId          String
  clientId          String?
  storeId           String?
  templateId        String?
  template          NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  channel           NotificationChannel
  event             NotificationEvent
  orderId           String?
  /// Maskeli saklanır (KVKK): a***@x.com / +90 5** *** 12 34. Ham alıcı yalnız kuyruk işinde yaşar.
  recipient         String
  subject           String?
  renderedBody      String                @db.Text
  status            NotificationLogStatus @default(QUEUED)
  provider          String
  providerMessageId String?
  errorMessage      String?
  attempts          Int                   @default(0)
  sentAt            DateTime?
  isTest            Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([agencyId])
  @@index([storeId, createdAt])
  @@index([orderId])
  @@index([status])
}

/// Kanal başına sağlayıcı; ajans seviyesi (marka/mağaza seviyesi gerekirse scopeKey eklenir).
model NotificationProviderConfig {
  id               String              @id @default(cuid())
  agencyId         String
  channel          NotificationChannel
  /// smtp | netgsm | console
  provider         String
  /// Gizli olmayan alanlar: host, port, secure, fromEmail, fromName, senderId, username…
  config           Json                @default("{}")
  /// encryption.util ile şifreli JSON: password, apiKey…
  secretsEncrypted String?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?

  @@unique([agencyId, channel])
  @@index([agencyId])
}
